{
  "name": "pinduoduo-scraper",
  "version": "1.0.0",
  "description": "Professional Pinduoduo Desktop Scraper",
  "main": "electron/main/index.js",
  "scripts": {
    "dev": "node ./scripts/dev-preflight.js && node ./node_modules/concurrently/dist/bin/concurrently.js \"npm run dev:renderer\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:renderer": "vite",
    "build": "vite build && electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-log": "^5.0.1",
    "puppeteer": "^21.6.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "^0.33.1",
    "sql.js": "^1.10.0",
    "uuid": "^9.0.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.10",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.scraper.pinduoduo",
    "productName": "Pinduoduo Scraper",
    "directories": {
      "output": "dist-electron"
    }
  }
}
